# Copy this file to .env before starting the project.
# Replace change_me locally. Never commit the real .env file.

# PostgreSQL initialization
DB_USER=transcendence
DB_PASSWORD=change_me
DB_NAME=transcendence

# Future connection for Prisma and the Node.js backend inside Docker Compose.
# Its user, password and database name must match the values above.
DATABASE_URL=postgresql://transcendence:change_me@db:5432/transcendence?schema=public

# Runtime URLs. They may temporarily use the shared development account above;
# dedicated least-privilege users will replace it when SQL roles are provisioned.
AUTH_DATABASE_URL=postgresql://transcendence:change_me@db:5432/transcendence?schema=auth
USER_DATABASE_URL=postgresql://transcendence:change_me@db:5432/transcendence?schema=users
CATALOG_DATABASE_URL=postgresql://transcendence:change_me@db:5432/transcendence?schema=catalog
MEDIA_DATABASE_URL=postgresql://transcendence:change_me@db:5432/transcendence?schema=media
LIBRARY_DATABASE_URL=postgresql://transcendence:change_me@db:5432/transcendence?schema=library
PLAYBACK_DATABASE_URL=postgresql://transcendence:change_me@db:5432/transcendence?schema=playback

# Prisma CLI only. In a real environment these URLs must use migration owners,
# never the restricted accounts used by the HTTP services.
AUTH_MIGRATION_DATABASE_URL=postgresql://transcendence:change_me@db:5432/transcendence?schema=auth
USER_MIGRATION_DATABASE_URL=postgresql://transcendence:change_me@db:5432/transcendence?schema=public
CATALOG_MIGRATION_DATABASE_URL=postgresql://transcendence:change_me@db:5432/transcendence?schema=catalog
MEDIA_MIGRATION_DATABASE_URL=postgresql://transcendence:change_me@db:5432/transcendence?schema=media
LIBRARY_MIGRATION_DATABASE_URL=postgresql://transcendence:change_me@db:5432/transcendence?schema=library
PLAYBACK_MIGRATION_DATABASE_URL=postgresql://transcendence:change_me@db:5432/transcendence?schema=playback

JWT_SECRET=change_me_something_long_and_random

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_admin_password
