# Copy this file to .env before starting the project.
# Replace change_me locally. Never commit the real .env file.

# PostgreSQL initialization
DB_USER=transcendence_admin
DB_PASSWORD=change_me
DB_NAME=transcendence

# One migration owner and one restricted runtime login per service.
AUTH_MIGRATION_PASSWORD=change_me_auth_migration
AUTH_RUNTIME_PASSWORD=change_me_auth_runtime
USERS_MIGRATION_PASSWORD=change_me_users_migration
USERS_RUNTIME_PASSWORD=change_me_users_runtime
CATALOG_MIGRATION_PASSWORD=change_me_catalog_migration
CATALOG_RUNTIME_PASSWORD=change_me_catalog_runtime
MEDIA_MIGRATION_PASSWORD=change_me_media_migration
MEDIA_RUNTIME_PASSWORD=change_me_media_runtime
LIBRARY_MIGRATION_PASSWORD=change_me_library_migration
LIBRARY_RUNTIME_PASSWORD=change_me_library_runtime
PLAYBACK_MIGRATION_PASSWORD=change_me_playback_migration
PLAYBACK_RUNTIME_PASSWORD=change_me_playback_runtime

# Runtime URLs use only the restricted identity of their service.
AUTH_DATABASE_URL=postgresql://auth_runtime:change_me_auth_runtime@db:5432/transcendence?schema=auth
USER_DATABASE_URL=postgresql://users_runtime:change_me_users_runtime@db:5432/transcendence?schema=users
CATALOG_DATABASE_URL=postgresql://catalog_runtime:change_me_catalog_runtime@db:5432/transcendence?schema=catalog
MEDIA_DATABASE_URL=postgresql://media_runtime:change_me_media_runtime@db:5432/transcendence?schema=media
LIBRARY_DATABASE_URL=postgresql://library_runtime:change_me_library_runtime@db:5432/transcendence?schema=library
PLAYBACK_DATABASE_URL=postgresql://playback_runtime:change_me_playback_runtime@db:5432/transcendence?schema=playback

# Prisma CLI only. These identities own their schema and never run HTTP code.
AUTH_MIGRATION_DATABASE_URL=postgresql://auth_migration:change_me_auth_migration@db:5432/transcendence?schema=auth
USER_MIGRATION_DATABASE_URL=postgresql://users_migration:change_me_users_migration@db:5432/transcendence?schema=users
CATALOG_MIGRATION_DATABASE_URL=postgresql://catalog_migration:change_me_catalog_migration@db:5432/transcendence?schema=catalog
MEDIA_MIGRATION_DATABASE_URL=postgresql://media_migration:change_me_media_migration@db:5432/transcendence?schema=media
LIBRARY_MIGRATION_DATABASE_URL=postgresql://library_migration:change_me_library_migration@db:5432/transcendence?schema=library
PLAYBACK_MIGRATION_DATABASE_URL=postgresql://playback_migration:change_me_playback_migration@db:5432/transcendence?schema=playback

JWT_SECRET=change_me_something_long_and_random

# Credential used only for Auth -> Users internal commands. Generate a distinct,
# long random value locally and never expose the /internal routes through Nginx.
INTERNAL_SERVICE_TOKEN=change_me_another_long_random_value

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_admin_password
