// Modèles possédés par ce service ; les références vers les autres services restent des UUID logiques.
generator client {
  /// Moteur du client ou de la base ; ce choix détermine la génération et les opérations disponibles.
  provider            = "prisma-client"
  /// Dossier du client Prisma généré, exclu des modifications manuelles.
  output              = "../src/generated/prisma"
  /// Format ESM des modules générés, aligné sur les imports du service.
  moduleFormat        = "esm"
  /// Extension .js des imports après compilation TypeScript.
  importFileExtension = "js"
}

datasource db {
  /// Moteur du client ou de la base ; ce choix détermine la génération et les opérations disponibles.
  provider = "postgresql"
  /// Schéma PostgreSQL possédé par ce service ; l’URL runtime choisit son rôle limité.
  schemas  = ["playback"]
}

/// Écoute liée au compte, avec durée figée et temps crédité distinct de la dernière position.
model Session {
  /// Identifiant de cette entité ; distinct des identifiants des objets liés.
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// UUID du compte auquel le profil ou la demande est rattaché.
  userId              String?   @map("user_id") @db.Uuid
  /// UUID du morceau Catalogue, distinct de l’occurrence de playlist ou de la session.
  trackId             String    @map("track_id") @db.Uuid
  /// Durée du morceau en millisecondes, figée à l’ouverture de la session.
  trackDurationMs     BigInt    @map("track_duration_ms")
  /// Date d’ouverture de la session ; format ISO côté client, Date côté stockage.
  startedAt           DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  /// Date de clôture ; null tant que la session reste ouverte.
  endedAt             DateTime? @map("ended_at") @db.Timestamptz(6)
  /// Temps crédité par le serveur en millisecondes, plafonné à la durée du morceau.
  listenedMs          BigInt    @default(0) @map("listened_ms")
  /// Dernière séquence de progression confirmée par le serveur ; zéro avant le premier événement.
  lastSequence        Int       @default(0) @map("last_sequence")
  /// Indicateur réservé au modèle ; les routes actuelles ne le calculent pas automatiquement.
  qualified           Boolean   @default(false)
  /// Version de la règle de comptage enregistrée avec la session.
  countingRuleVersion Int       @default(1) @map("counting_rule_version")

  /// Événements nécessaires pour retrouver la dernière position confirmée.
  events Event[]

  @@index([userId, startedAt, id], map: "listening_history_idx")
  @@map("sessions")
  @@schema("playback")
}

/// Progression identifiée par session et séquence ; conserve le cumul déclaré et la position en millisecondes.
model Event {
  /// UUID local de la session ; avec sequence, identifie un événement unique.
  sessionId       String   @map("session_id") @db.Uuid
  /// Numéro positif de l’événement ; une répétition garde le même numéro et les mêmes valeurs.
  sequence        Int
  /// Cumul local déclaré en millisecondes ; le serveur borne le crédit réellement retenu.
  listenedMsTotal BigInt   @map("listened_ms_total")
  /// Position dans le morceau en millisecondes ; un déplacement ne vaut pas du temps écouté.
  positionMs      BigInt   @map("position_ms")
  /// Date de réception de l’événement, prise sur l’horloge du serveur.
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  /// Relation locale vers la session, avec suppression en cascade de ses événements.
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, sequence])
  @@map("events")
  @@schema("playback")
}
