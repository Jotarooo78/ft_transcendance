// Modèles possédés par ce service ; les références vers les autres services restent des UUID logiques.
generator client {
  /// Moteur du client ou de la base ; ce choix détermine la génération et les opérations disponibles.
  provider            = "prisma-client"
  /// Dossier du client Prisma généré, exclu des modifications manuelles.
  output              = "../src/generated/prisma"
  /// Format ESM des modules générés, aligné sur les imports du service.
  moduleFormat        = "esm"
  /// Extension .js des imports après compilation TypeScript.
  importFileExtension = "js"
}

datasource db {
  /// Moteur du client ou de la base ; ce choix détermine la génération et les opérations disponibles.
  provider = "postgresql"
  /// Schéma PostgreSQL possédé par ce service ; l’URL runtime choisit son rôle limité.
  schemas  = ["auth"]
}

/// Identité et mot de passe possédés par Auth ; le compte reste pending_profile jusqu’à confirmation Users.
model Account {
  /// Identifiant de cette entité ; distinct des identifiants des objets liés.
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Adresse utilisée pour identifier le compte à la connexion.
  email        String   @unique
  /// Empreinte du mot de passe conservée côté Auth, jamais un mot de passe en clair.
  passwordHash String   @map("password_hash")
  /// pending_profile, active ou profile_failed après livraison Users.
  state        String   @default("pending_profile")
  /// Date de création prise par PostgreSQL.
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Date actualisée par Prisma lors des modifications.
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Demandes locales de profil liées à ce compte.
  outboxMessages OutboxMessage[]

  @@map("accounts")
  @@schema("auth")
}

/// Demande durable liée au compte, relancée après une panne sans changer son identité.
model OutboxMessage {
  /// Identifiant de cette entité ; distinct des identifiants des objets liés.
  id               String    @id @db.Uuid
  /// Nom versionné de l’événement ProfileProvisionRequested.v1.
  type             String
  /// UUID du compte concerné par cette commande de profil.
  aggregateId      String    @map("aggregate_id") @db.Uuid
  /// Version entière de l’entité concernée par la commande.
  aggregateVersion Int       @default(1) @map("aggregate_version")
  /// Données du jeton ou du message, à valider avant leur utilisation.
  payload          Json
  /// pending, delivered ou failed pour la livraison.
  status           String    @default("pending")
  /// Nombre de tentatives de livraison déjà comptées.
  attempts         Int       @default(0)
  /// Date à partir de laquelle la demande pending peut être relivrée.
  nextAttemptAt    DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  /// Code du dernier refus de livraison, sans message sensible.
  lastError        String?   @map("last_error")
  /// Date de création prise par PostgreSQL.
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Date de confirmation de la livraison ; null avant réussite.
  deliveredAt      DateTime? @map("delivered_at") @db.Timestamptz(6)

  /// Compte créé dans la même transaction que sa demande de profil.
  account Account @relation(fields: [aggregateId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([aggregateId])
  @@map("outbox_messages")
  @@schema("auth")
}
