    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@ft/service-kit": "*",
    "fastify": "^5.12.1",
    "typebox": "^1.3.37"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
