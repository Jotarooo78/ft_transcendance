// Modèles possédés par ce service ; les références vers les autres services restent des UUID logiques.
generator client {
  /// Moteur du client ou de la base ; ce choix détermine la génération et les opérations disponibles.
  provider            = "prisma-client"
  /// Dossier du client Prisma généré, exclu des modifications manuelles.
  output              = "../src/generated/prisma"
  /// Format ESM des modules générés, aligné sur les imports du service.
  moduleFormat        = "esm"
  /// Extension .js des imports après compilation TypeScript.
  importFileExtension = "js"
}

datasource db {
  /// Moteur du client ou de la base ; ce choix détermine la génération et les opérations disponibles.
  provider = "postgresql"
  /// Schéma PostgreSQL possédé par ce service ; l’URL runtime choisit son rôle limité.
  schemas  = ["catalog"]
}

/// Artiste du catalogue ; imageAssetId est une référence logique vers Media.
model Artist {
  /// Identifiant de cette entité ; distinct des identifiants des objets liés.
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Nom de la playlist ou libellé lu par cette projection.
  name         String
  /// Nom de chemin unique de l’artiste, distinct de son nom affiché.
  slug         String   @unique
  /// Présentation facultative de l’artiste ; distincte de la bio du profil utilisateur.
  bio          String?
  /// UUID logique du fichier Media utilisé comme image d’artiste ; protège la suppression même sans publication.
  imageAssetId String?  @map("image_asset_id") @db.Uuid
  /// Date de création prise par PostgreSQL.
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Date actualisée par Prisma lors des modifications.
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Associations locales entre l’artiste et les comptes membres.
  members        ArtistMember[]
  /// Crédits de l’artiste sur des morceaux.
  trackCredits   TrackArtist[]
  /// Crédits de l’artiste sur des sorties.
  releaseCredits ReleaseArtist[]

  @@map("artists")
  @@schema("catalog")
}

/// Association entre un artiste et un compte ; le rôle décrit la participation, sans clé étrangère vers Users.
model ArtistMember {
  /// UUID de l’artiste Catalogue lié localement.
  artistId  String   @map("artist_id") @db.Uuid
  /// UUID du compte auquel le profil ou la demande est rattaché.
  userId    String   @map("user_id") @db.Uuid
  /// Rôle du crédit ou de la participation, distinct de l’ordre d’affichage.
  role      String
  /// Date de création prise par PostgreSQL.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Relation locale vers l’artiste crédité ; suppression contrôlée par sa clé étrangère.
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([artistId, userId])
  @@index([userId], map: "artist_members_user_idx")
  @@map("artist_members")
  @@schema("catalog")
}

/// Morceau et état de publication ; audioAssetId référence Media sans déplacer la propriété du fichier.
model Track {
  /// Identifiant de cette entité ; distinct des identifiants des objets liés.
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Titre du morceau publié.
  title           String
  /// Présentation libre du morceau, limitée à 5 000 caractères par le serveur et PostgreSQL.
  description     String?
  /// UUID du fichier Media lié au morceau ; null si aucun audio n’est associé.
  audioAssetId    String?   @map("audio_asset_id") @db.Uuid
  /// Durée en millisecondes ; null lorsque cette durée n’est pas disponible ou ne s’applique pas.
  durationMs      BigInt?   @map("duration_ms")
  /// Indicateur de contenu explicite du morceau.
  explicit        Boolean   @default(false)
  /// draft ou published ; les lectures publiques filtrent published.
  status          String    @default("draft")
  /// Date de publication requise avec les autres champs lors du passage à published.
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  /// UUID logique du compte auteur du morceau, sans clé étrangère vers Auth ou Users.
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  /// Version du morceau stockée dans le modèle ; distincte de la version de playlist.
  version         BigInt    @default(1)
  /// Date de création prise par PostgreSQL.
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Date actualisée par Prisma lors des modifications.
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Crédits ordonnés d’artistes sur cet objet Catalogue.
  artists       TrackArtist[]
  /// Occurrences de ce morceau dans les sorties.
  releaseTracks ReleaseTrack[]
  /// Associations locales aux genres, indépendantes de la projection du genre affiché.
  genres        TrackGenre[]

  @@map("tracks")
  @@schema("catalog")
}

/// Crédit d’un artiste sur un morceau avec rôle et ordre distincts.
model TrackArtist {
  /// UUID du morceau Catalogue, distinct de l’occurrence de playlist ou de la session.
  /// UUID du morceau Catalogue, distinct de l’occurrence de playlist ou de la session.
  trackId     String @map("track_id") @db.Uuid
  /// UUID de l’artiste Catalogue lié localement.
  /// UUID de l’artiste Catalogue lié localement.
  artistId    String @map("artist_id") @db.Uuid
  /// Rôle du crédit ou de la participation, distinct de l’ordre d’affichage.
  role        String
  /// Ordre positif des crédits pour afficher les artistes de façon déterministe.
  /// Ordre positif des crédits pour afficher les artistes de façon déterministe.
  creditOrder Int    @map("credit_order")

  /// Relation locale vers le morceau Catalogue ; distincte d’un UUID logique interservices.
  track  Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  /// Relation locale vers l’artiste crédité ; suppression contrôlée par sa clé étrangère.
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Restrict)

  @@id([trackId, artistId, role])
  @@unique([trackId, role, creditOrder], map: "track_artists_track_role_order_key")
  @@index([artistId], map: "track_artists_artist_idx")
  @@map("track_artists")
  @@schema("catalog")
}

/// Sortie musicale et ses métadonnées ; coverAssetId est une référence logique vers Media.
model Release {
  /// Identifiant de cette entité ; distinct des identifiants des objets liés.
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Titre du morceau publié.
  title        String
  /// Catégorie de sortie conservée dans Catalogue.
  releaseType  String    @map("release_type")
  /// Date de sortie sans heure ni fuseau, contrairement aux dates techniques de création.
  releaseDate  DateTime? @map("release_date") @db.Date
  /// UUID logique de la couverture Media ; protège la suppression même pour une sortie en brouillon.
  coverAssetId String?   @map("cover_asset_id") @db.Uuid
  /// draft ou published ; les lectures publiques filtrent published.
  status       String    @default("draft")
  /// Date de création prise par PostgreSQL.
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Date actualisée par Prisma lors des modifications.
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Crédits ordonnés d’artistes sur cet objet Catalogue.
  artists ReleaseArtist[]
  /// Associations aux morceaux, selon le modèle local contenant cette relation.
  tracks  ReleaseTrack[]

  @@map("releases")
  @@schema("catalog")
}

/// Crédit ordonné d’un artiste sur une sortie.
model ReleaseArtist {
  /// UUID de la sortie Catalogue liée localement.
  /// UUID de la sortie Catalogue liée localement.
  releaseId   String @map("release_id") @db.Uuid
  artistId    String @map("artist_id") @db.Uuid
  creditOrder Int    @map("credit_order")

  /// Relation locale vers la sortie musicale.
  /// Relation locale vers la sortie musicale.
  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  /// Relation locale vers l’artiste crédité ; suppression contrôlée par sa clé étrangère.
  artist  Artist  @relation(fields: [artistId], references: [id], onDelete: Restrict)

  @@id([releaseId, artistId])
  @@unique([releaseId, creditOrder], map: "release_artists_release_order_key")
  @@index([artistId], map: "release_artists_artist_idx")
  @@map("release_artists")
  @@schema("catalog")
}

/// Occurrence d’un morceau dans une sortie, identifiée par disque et numéro de piste.
model ReleaseTrack {
  /// Identifiant de cette entité ; distinct des identifiants des objets liés.
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  releaseId   String @map("release_id") @db.Uuid
  trackId     String @map("track_id") @db.Uuid
  /// Numéro de disque à partir de 1 pour les sorties comprenant plusieurs disques.
  discNumber  Int    @default(1) @map("disc_number")
  /// Numéro du morceau sur le disque ; combiné à releaseId et discNumber pour l’unicité.
  trackNumber Int    @map("track_number")

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  /// Relation locale vers le morceau Catalogue ; distincte d’un UUID logique interservices.
  track   Track   @relation(fields: [trackId], references: [id], onDelete: Restrict)

  @@unique([releaseId, discNumber, trackNumber], map: "release_tracks_release_position_key")
  @@index([trackId], map: "release_tracks_track_idx")
  @@map("release_tracks")
  @@schema("catalog")
}

/// Genre unique utilisé par les filtres publics du catalogue.
model Genre {
  /// Identifiant de cette entité ; distinct des identifiants des objets liés.
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Nom de la playlist ou libellé lu par cette projection.
  name String @unique

  /// Associations aux morceaux, selon le modèle local contenant cette relation.
  tracks TrackGenre[]

  @@map("genres")
  @@schema("catalog")
}

/// Association locale plusieurs-à-plusieurs entre morceaux et genres.
model TrackGenre {
  /// UUID du morceau Catalogue, distinct de l’occurrence de playlist ou de la session.
  trackId String @map("track_id") @db.Uuid
  /// UUID du genre Catalogue lié localement.
  genreId String @map("genre_id") @db.Uuid

  /// Relation locale vers le morceau Catalogue ; distincte d’un UUID logique interservices.
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  /// Relation locale vers le genre associé au morceau.
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@id([trackId, genreId])
  @@index([genreId], map: "track_genres_genre_idx")
  @@map("track_genres")
  @@schema("catalog")
}
