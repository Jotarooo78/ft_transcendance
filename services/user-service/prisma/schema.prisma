generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["users"]
}

model Profile {
  userId      String   @id @map("user_id") @db.Uuid
  username    String   @unique
  displayName String   @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  friendsInitiated Friend[]   @relation("friends_initiated")
  friendsReceived  Friend[]   @relation("friends_received")
  presence         Presence?

  @@map("profiles")
  @@schema("users")
}

model InboxMessage {
  id               String   @id @db.Uuid
  type             String
  aggregateId      String   @map("aggregate_id") @db.Uuid
  aggregateVersion Int      @map("aggregate_version")
  result           Json
  processedAt      DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@index([aggregateId])
  @@map("inbox_messages")
  @@schema("users")
}

model Friend {
  userId    String   @map("user_id") @db.Uuid
  friendId  String   @map("friend_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   Profile @relation("friends_initiated", fields: [userId], references: [userId], onDelete: Cascade)
  friend Profile @relation("friends_received", fields: [friendId], references: [userId], onDelete: Cascade)

  @@id([userId, friendId])
  @@index([friendId], map: "friends_friend_id_idx")
  @@map("friends")
  @@schema("users")
}

model Presence {
  userId     String   @id @map("user_id") @db.Uuid
  isOnline   Boolean  @default(false) @map("is_online")
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("presences")
  @@schema("users")
}
